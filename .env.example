# Copy this file to ".env" and paste your real bot token after the =
# Never commit the real .env file — it's like a password for your bot.
DISCORD_TOKEN=paste-your-token-here

# Optional but recommended while learning: your server's ID, so new/changed
# commands appear instantly instead of taking up to an hour.
# Get it: Discord Settings > Advanced > turn ON Developer Mode, then
# right-click your server icon > Copy Server ID.
GUILD_ID=paste-your-server-id-here

# Optional: YOUR Discord user ID. When set, the AI treats messages from this ID
# as the verified owner (a user ID can't be faked, unlike a nickname). Leave as 0
# to disable. Get it: Settings > Advanced > Developer Mode ON, then right-click
# your own name > Copy User ID.
OWNER_ID=0

# Voice assistant (experimental, assistant/): Discord user IDs allowed to talk to
# Syntia by voice, comma-separated. Nobody else's audio is even decrypted.
VOICE_USER_IDS=
# Path to the Piper voice (.onnx, with its .onnx.json next to it) Syntia speaks with.
PIPER_MODEL=
# Speech-to-text device: cuda (fast, ~1 GB VRAM) or cpu (keeps the GPU free, ~3 s per command)
STT_DEVICE=cuda

# Leave the voice channel after this many minutes with no music playing (or with
# nobody left listening). Admins can change it per server with `syntia timeout`
# until the next restart. 0 = off by default.
IDLE_TIMEOUT_MINUTES=5

# Starting playback volume in percent (0-100) for every server. `syntia volume`
# changes it per server until the next restart.
DEFAULT_VOLUME=100

# Which AI to use: "gemini" (cloud, free tier) or "ollama" (local, no limits).
AI_BACKEND=gemini

# Google AI Studio key for the AI fallback (free tier). Needed if AI_BACKEND=gemini.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# Local model name, used when AI_BACKEND=ollama (must support tool calling).
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Spotify credentials. OPTIONAL: public playlist/album/track links already work
# without them (read off Spotify's public embed page). Setting these only lifts
# the embed's track cap (~50-100) on long playlists, via the official API.
# Free: https://developer.spotify.com/dashboard -> Create app -> copy ID & secret.
# Also needs a one-time login:  .venv\Scripts\python.exe spotify_login.py
SPOTIFY_CLIENT_ID=paste-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=paste-your-spotify-client-secret
# Must EXACTLY match a Redirect URI in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
